{
  "name": "vision-deficiency-simulator",
  "version": "1.0.0",
  "description": "A client-side WCAG accessibility tool for simulating vision deficiencies. Test how your designs, UI, and content appear to users with different visual conditions.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsJust-tools/vision-deficiency-simulator.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run build -w @itsjust/core && next build",
    "start": "next start",
    "lint": "mkdir -p test-results && eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "prepare": "husky || true",
    "deps:check": "depcheck",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "next": "^16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0",
    "yarn": ">=1.22.0"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "depcheck": "^1.4.7",
    "eslint": "^10",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.0",
    "tsup": "^8.5.1",
    "typescript": "^6",
    "vitest": "^4.1.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "lint-staged": "^17.0.7"
  },
  "optionalDependencies": {
    "@emnapi/runtime": "^1.11.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css,mdx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
